# Cloudinary server credentials. Never prefix these with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=code-cubicle-impact

# OpenRouter. The key stays on the server and is never sent to the browser.
OPENROUTER_API_KEY=

# Model defaults were chosen by testing each candidate against the live API.
# Grouping and the PS-01 query planner both request `response_format: json_object`,
# so they need a free model that actually honours JSON mode. Verified working:
#   nvidia/nemotron-3-super-120b-a12b:free  -> valid JSON in ~1.6s
# Most other free ids do NOT support JSON mode and return unparseable text, which
# is what caused the "invalid grouping" errors. Do not switch back to
# `openrouter/free`: it picks a random model per request, so it fails at random.
OPENROUTER_GROUP_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# The report is Markdown, not JSON, so it does not need JSON mode. This model
# answers in ~2s with a 1M-token context window, which suits a long report.
OPENROUTER_REPORT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Used for OpenRouter attribution headers and local links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

